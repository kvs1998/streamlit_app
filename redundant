SELECT 
    dt.database_name,
    dt.schema_name,
    dt.name AS dynamic_table_name,
    t.name AS task_name,
    t.warehouse AS warehouse_name,
    w.size AS warehouse_size
FROM snowflake.account_usage.dynamic_tables dt
JOIN snowflake.account_usage.tasks t
    ON dt.task_id = t.id
JOIN snowflake.account_usage.warehouses w
    ON t.warehouse = w.name
ORDER BY dt.database_name, dt.schema_name, dt.name;

WITH params AS (
    SELECT
        UPPER('') AS table_schema,
        UPPER('') AS table_name
),

old_cols AS (
    SELECT
        'OLD' AS source_name,
        f.value::string AS column_name
    FROM params p,
         LATERAL FLATTEN(
             input => ARRAY_CONSTRUCT(
                 '
             )
         ) f
),

new_cols AS (
    SELECT
        'NEW' AS source_name,
        f.value::string AS column_name
    FROM params p,
         LATERAL FLATTEN(
             input => ARRAY_CONSTRUCT(
                 
             )
         ) f
),

expected AS (
    SELECT * FROM old_cols
    UNION ALL
    SELECT * FROM new_cols
)

SELECT
    e.source_name,
    e.column_name,
    c.column_name IS NOT NULL AS column_exists
FROM expected e
CROSS JOIN params p
LEFT JOIN INFORMATION_SCHEMA.COLUMNS c
    ON c.table_schema = p.table_schema
   AND c.table_name   = p.table_name
   AND c.column_name  = UPPER(e.column_name)
ORDER BY e.source_name, e.column_name;
